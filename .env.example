# MIRA Environment Variables
# Copy this file to .env and customize as needed.

# Storage configuration
MIRA_STORAGE_TYPE=sqlite
MIRA_DATA_PATH=/home/mira/.mira

# PostgreSQL (when using postgres storage type)
# MIRA_POSTGRES_URL=postgres://user:password@localhost:5432/mira?sslmode=disable

# Encryption keys
# MIRA_SQLITE_KEY=your-sqlite-encryption-key
# MIRA_HNSW_KEY=your-hnsw-encryption-key

# Webhooks
# MIRA_WEBHOOK_ENDPOINT=https://your-webhook-endpoint.com
